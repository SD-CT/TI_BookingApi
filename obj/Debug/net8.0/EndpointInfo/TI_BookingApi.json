  "components": {
    "schemas": {
      "ActivityDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifiant unique de l'activité",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Nom de l'activité",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Description de l'activité",
            "nullable": true
          },
          "price": {
            "type": "number",
            "description": "Prix par personne",
            "format": "double"
          },
          "maxCapacity": {
            "type": "integer",
            "description": "Capacité maximale",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "description": "Date de début",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "description": "Date de fin",
            "format": "date-time"
          },
          "currentBookings": {
            "type": "integer",
            "description": "Nombre de réservations actuelles",
            "format": "int32"
          },
          "isActive": {
            "type": "boolean",
            "description": "Activité active ou non"
          }
        },
        "additionalProperties": false
      },
      "BookingDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "activityId": {
            "type": "string",
            "format": "uuid"
          },
          "customerEmail": {
            "type": "string",
            "nullable": true
          },
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "numberOfPeople": {
            "type": "integer",
            "format": "int32"
          },
          "bookingDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/BookingStatus"
          },
          "totalPrice": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "BookingStatus": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "CreateActivityDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string",
            "description": "Nom de l'activité"
          },
          "description": {
            "type": "string",
            "description": "Description détaillée de l'activité",
            "nullable": true
          },
          "price": {
            "minimum": 0,01,
            "type": "number",
            "description": "Prix par personne en euros",
            "format": "double"
          },
          "maxCapacity": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Capacité maximale de participants",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "description": "Date et heure de début",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "description": "Date et heure de fin",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreateBookingDto": {
        "type": "object",
        "properties": {
          "activityId": {
            "type": "string",
            "format": "uuid"
          },
          "customerEmail": {
            "type": "string",
            "nullable": true
          },
          "customerName": {
            "type": "string",
            "nullable": true
          },
          "numberOfPeople": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
